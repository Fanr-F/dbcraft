{
  "name": "dbcraft",
  "version": "0.1.0",
  "description": "Lightweight Electron database client for SQLite, MySQL, Percona, MariaDB and MSSQL.",
  "main": "./out/main/index.js",
  "author": "fanzhouqi",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "e2e:sqlite": "npm run build && node scripts/e2e-sqlite.mjs",
    "demo:db": "node scripts/create-demo-db.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@revolist/react-datagrid": "^4.31.4",
    "better-sqlite3": "^13.0.3",
    "mariadb": "^3.5.4",
    "mysql2": "^3.24.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
